using System;
using System.Windows.Forms;
using GTA;
using GTA.Native;
using GTA.Math;

public class TransporteRealista : Script
{
    private Vehicle reboqueConectado = null;
    private bool estaEngatado = false;
    private float pesoCarga = 0.0f; // Peso que será lido

    public TransporteRealista()
    {
        Tick += OnTick;
        KeyDown += OnKeyDown;
    }

    private void OnKeyDown(object sender, KeyEventArgs e)
    {
        // Tecla J para engatar/desengatar reboque ou carroça
        if (e.KeyCode == Keys.J)
        {
            Entity veiculoPrincipal = Game.Player.Character.CurrentVehicle;
            if (veiculoPrincipal == null) return;

            if (!estaEngatado)
            {
                // Busca reboques ou carroças num raio de 5 metros
                Vehicle[] proximos = World.GetNearbyVehicles(veiculoPrincipal.Position, 5.0f);
                foreach (var v in proximos)
                {
                    if (v != veiculoPrincipal)
                    {
                        reboqueConectado = v;
                        // Engata o reboque atrás do cavalo/veículo
                        reboqueConectado.AttachTo(veiculoPrincipal, 0, new Vector3(0.0f, -2.5f, 0.0f), new Vector3(0.0f, 0.0f, 0.0f));
                        estaEngatado = true;
                        UI.Notify("Carga Conectada.");
                        break;
                    }
                }
            }
            else
            {
                reboqueConectado.Detach();
                estaEngatado = false;
                reboqueConectado = null;
                UI.Notify("Carga Desconectada.");
            }
        }
    }

    private void OnTick(object sender, EventArgs e)
    {
        if (estaEngatado && reboqueConectado != null)
        {
            Entity veiculoPrincipal = Game.Player.Character.CurrentVehicle;
            if (veiculoPrincipal != null)
            {
                // LÓGICA DE PESO: Lê o peso (simulado por quantidade de itens ou tipo de carga)
                // Quanto maior o pesoCarga, menor o multiplicador de torque
                pesoCarga = 300.0f; // Exemplo de valor lido
                float limitador = 1.0f - (pesoCarga / 1000.0f); 

                if (limitador < 0.2f) limitador = 0.2f; // Não deixa o cavalo travar totalmente

                // Aplica a redução de potência/velocidade para realismo
                Function.Call(Hash.SET_VEHICLE_MAX_SPEED, veiculoPrincipal, 15.0f * limitador);
                Function.Call(Hash.SET_VEHICLE_CHEAT_POWER_REUSE, veiculoPrincipal, limitador);
            }
        }
    }
}
// Dentro do OnTick, para calcular o peso real dos itens em cima
var objetosPerto = World.GetNearbyProps(reboqueConectado.Position, 2.5f);
pesoCarga = objetosPerto.Length * 50.0f; // Cada caixa adiciona 50kg de peso

